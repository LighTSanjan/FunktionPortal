# ─── Supabase (hosted) ────────────────────────────────────
# Default path. For a fully self-hosted stack (no hosted Supabase project),
# comment this block out and use the "Supabase (self-hosted)" block below instead.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# OPTIONAL. Only needed by background jobs (getStorageUnscoped).
# Nothing in the request path uses it — document access runs on the caller's own
# session so storage RLS applies. Bypasses all policies; never expose to the browser.
SUPABASE_SECRET_KEY=""

# ─── Supabase (self-hosted) ───────────────────────────────
# Alternative to the hosted block above — use this when running the
# gotrue/postgrest/storage-api/kong services added to docker-compose.yml
# instead of a hosted Supabase project. Uncomment and fill in in place of the
# hosted block; do not set both at once. See supabase/init.sql and
# docker-compose.yml for how these services fit together.
#
# The publishable/anon key below is safe to expose in the browser; the
# service-role key bypasses RLS and must remain server-side. Both are JWTs
# signed by SUPABASE_JWT_SECRET — regenerate all three before anything beyond
# local dev.
#
# SUPABASE_URL="http://localhost:8000"
# NEXT_PUBLIC_SUPABASE_URL="http://localhost:8000"
# SUPABASE_JWT_SECRET="local-dev-jwt-secret-change-me-before-production-please"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNzEwMDAwMDAwLCJleHAiOjE4OTM0NTYwMDB9.c9RlKxgPm8jgrRipCJGJ8dv1dBHSN52c0lccBLM5Qzo"
# SUPABASE_SECRET_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJpYXQiOjE3MTAwMDAwMDAsImV4cCI6MTg5MzQ1NjAwMH0.beONMRAmVG_S4PPCzANHnbBeNl6iu9gJKyMF6MMcN9U"
#
# GoTrue email/password settings for the self-hosted `gotrue` service.
# Autoconfirm is convenient for local dev; disable it and configure real SMTP
# credentials for anything beyond local dev.
# GOTRUE_JWT_EXP="3600"
# GOTRUE_JWT_ADMIN_GROUP_NAME="service_role"
# GOTRUE_DISABLE_SIGNUP="false"
# GOTRUE_EXTERNAL_EMAIL_ENABLED="true"
# GOTRUE_MAILER_AUTOCONFIRM="true"
# GOTRUE_URI_ALLOW_LIST="http://localhost:3000/**"
# GOTRUE_SMTP_ADMIN_EMAIL="admin@example.com"
# GOTRUE_SMTP_HOST="localhost"
# GOTRUE_SMTP_PORT="2500"
# GOTRUE_SMTP_USER=""
# GOTRUE_SMTP_PASS=""
# GOTRUE_SMTP_SENDER_NAME="FUNKtion Treasury"

# ─── Database ─────────────────────────────────────────────
# REQUIRED. Dashboard > Project Settings > Database > Connection string > URI.
# The password is set once at project creation and is never retrievable through
# the API — it can only be reset — so this is the one value that has to be
# pasted in by hand.
#
# DATABASE_URL must use the TRANSACTION pooler (port 6543, ?pgbouncer=true).
# The app's runtime PrismaPg adapter opens one connection per request; on a
# serverless host the SESSION pooler (port 5432) holds one dedicated backend
# connection per invocation and exhausts Supabase's connection cap under any
# real concurrency ("max clients reached in session mode"). DIRECT_URL stays
# on the session pooler (5432) — migrations need a direct/session connection
# because DDL and advisory locks don't work over the transaction pooler.
DATABASE_URL="postgresql://...:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=30"
DIRECT_URL="postgresql://...:5432/postgres?connection_limit=25&pool_timeout=30"

# For the self-hosted stack instead, both point at the local postgres service
# added in docker-compose.yml — there is no separate pooler locally, so both
# URLs are the same connection:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/funktion?connection_limit=10&pool_timeout=30"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/funktion?connection_limit=25&pool_timeout=30"

# ─── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── RLS connection role ──────────────────────────────────
# REQUIRED on hosted Supabase. app_user's own login credential.
#
# dbAs() evaluates every query under row-level security as `app_user`. Hosted
# Supabase blocks SET ROLE from the `postgres` connection role to anything
# outside its platform allowlist (anon, authenticated, service_role), so
# `app_user` can only be reached by connecting to it directly. Leave this
# unset on local/self-hosted Postgres, which has no such restriction and
# falls back to SET ROLE on the shared admin connection.
APP_USER_DATABASE_URL=""

# ─── Who may sign in ──────────────────────────────────────
# Addresses on these domains join the club the first time they sign in and
# prove the address (emailed code, or Microsoft/Google vouching for it).
# Anybody else needs an invitation from Settings → Invitations.
# Default: mymail.sutd.edu.sg,alumni.sutd.edu.sg
ALLOWED_EMAIL_DOMAINS=""

# OPTIONAL. Microsoft tenant IDs whose sign-ins prove the address even without
# the xms_edov claim. SUTD's tenant ID is on the Azure app registration's
# Overview page (Directory (tenant) ID) — or add the xms_edov optional claim.
MICROSOFT_TENANT_IDS=""

# ─── Encryption of sensitive columns ──────────────────────
# REQUIRED before bank details can be saved. Coach bank account numbers are
# encrypted by the app before they reach the database (core/crypto/fields.ts).
# "id:<32 random bytes, base64>", newest first; older keys after a comma still
# decrypt. Generate one with:
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
# Then seal existing rows: npm run db:encrypt-fields -- --apply
# Lose this key and the stored numbers are gone — keep a copy in the club's
# password manager, not only in Vercel.
FIELD_ENCRYPTION_KEYS=""

# ─── Alerts ───────────────────────────────────────────────
# OPTIONAL. A private Telegram chat that hears about new sign-ins, exco
# grants, bank detail changes and server errors. Unset, nothing is sent.
# Bot token from @BotFather; chat ID from https://api.telegram.org/bot<token>/getUpdates
# after sending the bot a message.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALERT_CHAT_ID=""

# ─── Google Sheets (read-only) ────────────────────────────
# OPTIONAL until the register is read from Sheets. A Google Cloud service
# account key (the JSON file), base64-encoded onto one line:
#   base64 -i service-account.json | tr -d '\n'
# Share each spreadsheet with the account's client_email as a Viewer, then:
#   npm run google:check -- <spreadsheet URL>
GOOGLE_SERVICE_ACCOUNT_JSON=""

# ─── First-run bootstrap ──────────────────────────────────
# Comma-separated emails allowed to grant themselves EXCO on first sign-in.
#
# Membership is granted by an exco member, and on a fresh database there is no
# exco member to grant it — the first person to sign in would land on
# /onboarding with nobody able to admit them. This is the way out of that.
#
# It only creates a membership, never restores or escalates one, and it stops
# doing anything the moment any active membership exists. Unset it once the
# exco is set up.
BOOTSTRAP_EXCO_EMAILS=""

# ─── The deployment's own identity ────────────────────────
# What the portal calls itself before anybody has signed in: the browser tab,
# the sign-in page, the wordmark. All optional — the defaults are FUNKtion's.
#
# Everything a *document* says about an organisation comes from its settings
# row instead, editable at /:org/settings/organisation, because a document
# belongs to the organisation. These are the other half: on the sign-in page
# there is no organisation in scope yet, so it cannot come from the database.
#
# NEXT_PUBLIC_ means they are fixed at build time, which is the right lifetime
# for them: the sign-in page's wordmark is not something anybody should be
# able to change at runtime.
NEXT_PUBLIC_BRAND_NAME=""
NEXT_PUBLIC_BRAND_PRODUCT_NAME=""
NEXT_PUBLIC_BRAND_TAGLINE=""
NEXT_PUBLIC_BRAND_DESCRIPTION=""
# The email domain members actually type, shown as a placeholder. Set it to an
# empty value on purpose and the placeholder falls back to example.com rather
# than to somebody else's university.
NEXT_PUBLIC_BRAND_EMAIL_DOMAIN=""
# Paths under public/. Replace the files or point these at your own.
NEXT_PUBLIC_BRAND_WORDMARK=""
NEXT_PUBLIC_BRAND_MARK=""
