// FUNKtion Portal — identity schema
// User, OrganisationMembership, Invitation.
//
// A User is someone who can sign in. A Member (see finance.prisma) is
// someone on the club roster. Most members never sign in, and some users
// (a graduated treasurer retaining read access) are not on the roster, so
// the two are linked optionally rather than merged.

model User {
  id                        String   @id @default(uuid())
  email                     String   @unique
  name                      String
  isActive                  Boolean  @default(true) @map("is_active")
  emailNotificationsEnabled Boolean  @default(true) @map("email_notifications_enabled")
  telegramChatId            String?  @map("telegram_chat_id")

  /// Object key of the user's stored signature image, used to stamp the
  /// documents they sign off rather than making them wet-sign every month.
  ///
  /// A signature specimen is forgeable material. The bucket is private, the
  /// key is never rendered into a page, and the image is read server-side
  /// only while composing a document the user has just authorised. Replacing
  /// it is an audited act — see AuditLog.
  signatureImagePath  String?   @map("signature_image_path")
  signatureUpdatedAt  DateTime? @map("signature_updated_at")

  /// The student ID this account says it belongs to, waiting for an exco
  /// member to confirm. Student IDs are unique, which makes them the right
  /// key; they are printed on every attendance sheet and run sequentially,
  /// which is why a claim links nobody on its own.
  claimedStudentId   String?   @map("claimed_student_id")
  claimedStudentIdAt DateTime? @map("claimed_student_id_at")

  /// When and how this account last proved it holds its email — an emailed
  /// code, or a provider that vouched for the address. Written only by the
  /// portal in the request that saw the proof; Supabase's email_confirmed_at
  /// proves nothing while "Confirm email" is off. See core/auth/proof.ts.
  emailProvenAt  DateTime? @map("email_proven_at")
  emailProvenVia String?   @map("email_proven_via")

  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  memberships      OrganisationMembership[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  setupProgresses  OrgSetupProgress[]
  dashboardLayouts DashboardLayout[]

  accessRequests        AccessRequest[]   @relation("AccessRequestUser")
  accessRequestsReviewed AccessRequest[]  @relation("AccessRequestReviewer")
  member                Member?
  declaredPayments      FeePayment[]      @relation("PaymentDeclaredBy")
  confirmedPayments     FeePayment[]      @relation("PaymentConfirmedBy")
  recordedAttendance    SessionAttendance[]
  verifiedSheets        AttendanceSheet[]
  treasurerApprovals    PurchaseRequest[] @relation("TreasurerApprover")
  presidentApprovals    PurchaseRequest[] @relation("PresidentApprover")
  registerSyncsRequested RegisterSync[]
  attendanceImports     AttendanceImport[]
  settledCoachMonths    CoachMonthSettlement[]
  feeArrangementsSet    FeeArrangement[]

  @@index([claimedStudentId])
  @@map("users")
}

model OrganisationMembership {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  orgId     String   @map("org_id")
  role      OrgRole  @default(MEMBER)
  /// Only meaningful when role is EXCO. Null means "exco, no named post".
  /// Two people can hold the same office (an outgoing and incoming
  /// treasurer during handover), so this is deliberately not unique.
  office    ExcoOffice?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
  @@index([orgId, office])
  @@map("organisation_memberships")
}

model Invitation {
  id        String           @id @default(cuid())
  orgId     String           @map("org_id")
  email     String
  role      OrgRole          @default(MEMBER)
  token     String           @unique
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime         @map("expires_at")
  createdAt DateTime         @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([token])
  @@map("invitations")
}

/// A member asking for their access to be widened.
///
/// The inverse of Invitation: there, the club decides first; here, the person
/// asks and the club decides second. Both exist because the club needs both —
/// at handover the incoming exco can ask rather than wait to be found.
///
/// The role is the access; the office is a label that routes notifications and
/// prints under signatures and confers nothing. They are requested together
/// because that is how a person thinks about it ("I'm the new treasurer"), but
/// they are granted as two separate fields, so assigning an office later stays
/// a dropdown rather than a security decision.
model AccessRequest {
  id     String @id @default(cuid())
  orgId  String @map("org_id")
  userId String @map("user_id")

  requestedRole   OrgRole     @default(EXCO) @map("requested_role")
  requestedOffice ExcoOffice? @map("requested_office")
  /// Why they should have it, in their own words. Required: an approver
  /// deciding from a name alone is an approver clicking yes.
  reason String

  status AccessRequestStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  /// Stale requests are refused rather than approved. An approval acting on a
  /// six-month-old request is approving a decision nobody is still thinking of.
  expiresAt DateTime @map("expires_at")

  /// Never the requester. Enforced in the action and by a CHECK constraint,
  /// because a request somebody can approve for themselves is not an approval.
  reviewedByUserId String?   @map("reviewed_by_user_id")
  reviewedAt       DateTime? @map("reviewed_at")
  /// Shown to the requester, so a refusal is answerable rather than silent.
  decisionNote String? @map("decision_note")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation("AccessRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("AccessRequestReviewer", fields: [reviewedByUserId], references: [id])

  @@index([orgId, status])
  @@index([userId])
  @@map("access_requests")
}

/// Sign-in attempts per key, for rate-limiter-flexible. Admin connection only.
model RateLimit {
  key    String    @id
  points Int       @default(0)
  expire DateTime?

  @@map("rate_limits")
}
